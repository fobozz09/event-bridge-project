# critical_alert_service/.env.example
# Пример конфигурации - скопируйте в .env и измените при необходимости

# Настройки подключения к RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Имя очереди (должна быть создана оркестратором)
QUEUE_NAME=critical_alert_queue

# Настройки API Gateway для тестов
API_GATEWAY_HOST=localhost
API_GATEWAY_PORT=8080

# Запускать ли тесты при старте (true/false)
RUN_API_TESTS=true