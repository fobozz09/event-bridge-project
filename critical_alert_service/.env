# critical_alert_service/.env
# Конфигурация для VIP Консьерж Сервиса

# Настройки подключения к RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Имя очереди (создаётся оркестратором)
QUEUE_NAME=critical_alert_queue

# Настройки API Gateway для тестов
API_GATEWAY_HOST=api_gateway_service
API_GATEWAY_PORT=8000

# Запускать ли тесты при старте (true/false)
RUN_API_TESTS=true